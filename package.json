{
  "name": "@dietdev/synth",
  "version": "0.1.0",
  "description": "Синтез звуковых эффектов для игр по компактным пресетам: слои, толчки с разбросом, LFO, фильтры; рендер в WAV data URL",
  "keywords": [
    "audio",
    "sfx",
    "synth",
    "sound",
    "game",
    "typescript"
  ],
  "author": "Diet Dev <dietdev.tech@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diet-dev/synth.git"
  },
  "homepage": "https://github.com/diet-dev/synth#readme",
  "bugs": {
    "url": "https://github.com/diet-dev/synth/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "NOTICE.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.ts\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "dev": "vite",
    "build:demo": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
